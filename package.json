{
  "name": "jobqu",
  "version": "2.1.0",
  "description": "Queue to run jobs with unique keys at fixed intervals",
  "main": "dist/src/index.js",
  "typings": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "src"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "compile": "tsc",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && npm run compile",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InventivetalentDev/jobqu.git"
  },
  "bugs": {
    "url": "https://github.com/InventivetalentDev/jobqu/issues"
  },
  "homepage": "https://github.com/InventivetalentDev/jobqu#readme",
  "engines": {
    "node": ">=12"
  },
  "keywords": [
    "queue",
    "job"
  ],
  "author": "Haylee Schäfer",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
